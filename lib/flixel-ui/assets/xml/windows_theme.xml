<?xml version="1.0" encoding="utf-8" ?>
<data>
	<!-- Windows 95/98/2000 Theme Configuration -->
	
	<!-- Color Palette -->
	<colors>
		<color id="win_face" value="0xC0C0C0"/>        <!-- Button Face -->
		<color id="win_hilight" value="0xFFFFFF"/>     <!-- 3D Light -->
		<color id="win_light" value="0xDFDFDF"/>       <!-- 3D Highlight -->
		<color id="win_shadow" value="0x808080"/>      <!-- 3D Shadow -->
		<color id="win_dark_shadow" value="0x404040"/> <!-- 3D Dark Shadow -->
		<color id="win_blue" value="0x000080"/>        <!-- Title Bar Active -->
		<color id="win_blue_light" value="0x0A246A"/>  <!-- Title Bar Gradient -->
		<color id="win_text" value="0x000000"/>        <!-- Window Text -->
		<color id="win_gray_text" value="0x808080"/>   <!-- Disabled Text -->
		<color id="win_window" value="0xFFFFFF"/>      <!-- Window Background -->
		<color id="win_desktop" value="0x008080"/>     <!-- Desktop Teal -->
	</colors>
	
	<!-- Button Definitions -->
	<button>
		<graphic name="normal" src="assets/images/button.png"/>
		<graphic name="hover" src="assets/images/button.png"/>
		<graphic name="pressed" src="assets/images/button.png"/>
		<text_format id="sans12" color="0x000000"/>
	</button>
	
	<!-- Window Chrome -->
	<window>
		<chrome src="assets/images/chrome.png" slice9="4,20,4,4"/>
		<title_bar height="20" color="0x000080"/>
		<title_text format="title_text"/>
	</window>
	
	<!-- Checkbox Style -->
	<checkbox>
		<box width="13" height="13" background="0xFFFFFF" border="0x000000"/>
		<check src="assets/images/check_mark.png"/>
		<text format="sans12" color="0x000000"/>
	</checkbox>
	
	<!-- Radio Button Style -->
	<radio>
		<circle width="12" height="12" background="0xFFFFFF" border="0x000000"/>
		<dot src="assets/images/radio_dot.png"/>
		<text format="sans12" color="0x000000"/>
	</radio>
	
	<!-- Tab Style -->
	<tab>
		<inactive src="assets/images/tab.png" color="0xC0C0C0"/>
		<active src="assets/images/tab.png" color="0xFFFFFF"/>
		<text format="sans12" color="0x000000"/>
	</tab>
	
	<!-- Dropdown Style -->
	<dropdown>
		<button src="assets/images/button.png"/>
		<arrow src="assets/images/dropdown_mark.png"/>
		<list background="0xFFFFFF" border="0x000000"/>
		<text format="sans12" color="0x000000"/>
	</dropdown>
	
	<!-- Scrollbar Style -->
	<scrollbar>
		<track color="0xC0C0C0"/>
		<thumb src="assets/images/button.png"/>
		<arrow_up src="assets/images/button_arrow_up.png"/>
		<arrow_down src="assets/images/button_arrow_down.png"/>
	</scrollbar>
	
	<!-- Input Field Style -->
	<input>
		<background color="0xFFFFFF"/>
		<border src="assets/images/chrome_inset.png" slice9="2,2,2,2"/>
		<text format="sans12" color="0x000000"/>
		<cursor color="0x000000" width="1"/>
	</input>
	
	<!-- Tooltip Style -->
	<tooltip>
		<background color="0xFFFFE1"/>
		<border color="0x000000" width="1"/>
		<arrow src="assets/images/tooltip_arrow.png"/>
		<text format="sans10" color="0x000000"/>
	</tooltip>
	
</data>
