<?xml version="1.0" encoding="utf-8"?>
<project>
	<meta title="Fridsy Night Finkin': Sinkopeso Engine" package="com.ajdestroyer20.sinkopesoengine" version="1.0.0" company="Na" />
	
	<app main="Main" path="export" file="SinkopesoEngine" />
	
	<source path="source" />
	
	<haxelib name="lime" version="8.1.2" />
	<haxelib name="openfl" version="9.3.3" />
	<haxelib name="flixel" version="5.6.1" />
	<haxelib name="flixel-addons" version="3.2.2" />
	<haxelib name="flixel-tools" version="1.5.1" />
	<haxelib name="flxanimate" />
	<haxelib name="funkin.vis" />
	
	<haxelib name="grig.audio" />
	<haxelib name="tink_core" />
	<haxelib name="tjson" version="1.4.0" />
	<haxelib name="tjson" />

	<haxedef name="hscript_iris" />
	<haxelib name="hscript-iris" if="hscript_iris" />
	
	<haxedef name="FEATURE_HXVLC" />
	<haxelib name="hxvlc" version="2.0.1" if="FEATURE_HXVLC" />
	
	<haxedef name="LUA_ALLOWED" />
	<haxelib name="linc_luajit" if="LUA_ALLOWED" />
	
	<haxedef name="FEATURE_DISCORD" />
	<haxelib name="hxdiscord_rpc" version="1.2.4" if="FEATURE_DISCORD" />
	
	<haxedef name="FEATURE_AWAY3D" if="desktop" />
	<haxelib name="away3d" if="FEATURE_AWAY3D" version="5.0.9" />
	
	<classpath name="lib/flixel-ui" />
	
	<assets path="assets" />
	
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	
	<haxelib name="hxcpp-debug-server" version="1.2.4" if="cpp" />

	<section if="cpp">
		<haxedef name="HXCPP_CHECK_POINTER" if="debug" />
		<haxedef name="HXCPP_STACK_LINE" if="debug" />
	</section>
	
	<window width="1280" height="720" fps="120" background="#000000" hardware="true" vsync="false" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" />
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" />
	
	<window if="html5" resizable="true" />
	<window if="html5" require-shaders="true" />
	<window if="html5" allow-shaders="true" />

	<assets path='art/iconOG.png' rename='icon.png' if="linux"/>
	
	<icon path="art/icon16.png" size='16'/>
	<icon path="art/icon32.png" size='32'/>
	<icon path="art/icon64.png" size='64'/>
	<icon path="art/iconOG.png"/>
</project>
